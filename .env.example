# Example environment variables for deployment
# Use a managed MySQL service for production
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=inventory_db

# Optional SMTP for emails
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Flask secret key
FLASK_SECRET=

# Optional: set to '1' to enable debug (not recommended in prod)
DEBUG=0
